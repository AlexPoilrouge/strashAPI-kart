
    location ~ ^/kart/ {
        # for debug only
        {% if (api is defined) and (api.test is defined) and (api.test.allow_orig is defined) and not api.test.allow_orig %}# {% endif %}add_header Access-Control-Allow-Origin *;
        
        rewrite ^/kart/(.*) /$1 break;
        proxy_pass http://{{ api.nginx.access_addr }}:{{ api.nginx.access_port }};
    }
