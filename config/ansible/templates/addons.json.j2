{
    "racers": {
        {% for racer in racers %}"{{ racer.name }}" : {
            "directory" : "{{ racer.addons_directory }}"
        }{% if not loop.last %},{% endif %}{% endfor %}

    },
    "file_size_MB": {{ api.file_fetch_max_size_mb|default(128) }},
    "allowed_filenameExt": [
        ".cfg",
        ".kart",
        ".lua",
        ".pk3",
        ".wad",
        ".txt"
    ],
    "allowed_mimetypes": [
        "application/javascript",
        "application/octet-stream",
        "application/zip",
        "application/x-doom-wad",
        "application/x-doom",
        "text/plain"
    ]
}